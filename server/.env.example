BOT_TOKEN=123456:ABC
# Адрес мини-аппы на GitHub Pages
WEBAPP_URL=https://azat725.github.io/musique_bot.io/docs/
# Публичный адрес API (start.ps1 подставляет адрес туннеля автоматически)
PUBLIC_API_URL=
PORT=8000
# 1 — разрешить запросы без Telegram initData (только для локальной отладки)
DEBUG=0
# Битрейт потока для мини-аппы (бесплатный туннель медленный). 0 — отдавать оригинал (для VPS)
STREAM_BITRATE=64k
# Другие источники музыки (через запятую); уберите имя, чтобы выключить источник
SOURCES=zaycev,bandcamp,jamendo,archive,rutube
# Бесплатный ключ Jamendo (devportal.jamendo.com -> My Apps -> Client ID). Пусто = Jamendo выключен
JAMENDO_CLIENT_ID=
# Статичный адрес через ngrok (ngrok.com -> Domains). Если оба поля заполнены, start.ps1 использует ngrok
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Ваш Telegram id: на него приходят ежедневные копии базы, и только вы можете вызвать /backup.
# Не знаете id: отправьте боту /backup, он ответит им.
ADMIN_ID=
# Сколько копий базы хранить на сервере
BACKUP_KEEP=14
# Адрес сервера для мини-аппы, без https://. Без своего домена: IP через дефисы + .sslip.io (для 109.66.243.195 это 109-66-243-195.sslip.io)
API_DOMAIN=
# Ссылка на перевод автору (например, на счёт в банке): кнопка «Угостить чаем» в поддержке для русскоязычных.
# Платёжная ссылка личная, поэтому только здесь, в .env сервера, а не в репозитории. Пусто — кнопки нет.
SUPPORT_URL=
