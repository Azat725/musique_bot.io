# HTTPS in front of the API. Caddy gets and renews the certificate for API_DOMAIN by itself
# (Let's Encrypt, ZeroSSL as a spare) and redirects http to https.
{$API_DOMAIN} {
	# music is streamed: bytes go through at once without buffering, Range requests reach the app unchanged
	reverse_proxy musique:8000 {
		flush_interval -1
	}
}

# The site itself on its own domain (set SITE_DOMAIN once the domain points at this server): the app's files from
# docs/ and the API at the same address, so the site needs no ?api=. Unset, the harmless site.localhost is used.
{$SITE_DOMAIN:site.localhost} {
	handle /api/* {
		reverse_proxy musique:8000 {
			flush_interval -1
		}
	}
	handle {
		root * /srv/site
		file_server
	}
}
